# Redirects the overture.bio (marketing) build publishes.
#
# Netlify reads `_redirects` from the root of the deployed site. This file is in
# `static-marketing/`, which `docusaurus.config.ts` adds to `staticDirectories`
# only when OVERTURE_SITE=marketing, so the documentation build never ships it.
# That is what lets both sites build from one branch without a `netlify.toml`,
# which would be shared by both and would move docs.overture.bio's configuration
# out from under the Netlify UI where it lives today.
#
# Rules are matched in file order and the first match wins, so the
# `/documentation/*` catch-all has to stay last of its group. A trailing `!` on
# the status is Netlify's "force": apply even when a file exists at that path.
#
# These rules were staged as `netlify/marketing-redirects.toml` while the port
# ran and are now live here, with the reasoning that travelled with them.

# ---------------------------------------------------------------------------
# 1. /documentation/*, lifted from the Gatsby site that served overture.bio
# ---------------------------------------------------------------------------
#
# The /documentation section was retired: docs.overture.bio is the only Overture
# documentation surface. These URLs were public for years, so each section goes
# to its nearest equivalent on the docs site rather than to a single landing
# page. Ego and the DMS bundle have no successor, so they point at the Keycloak
# deployment guide and Prelude respectively.
#
# No `:splat` on the targets, deliberately: a deep URL under any of these lands
# on the section overview rather than 404ing at a path the docs site does not
# have. That was the Gatsby site's call and it still holds.
#
# These are cross-host and stay that way, so onBrokenLinks cannot validate any
# of them. Check them by hand when the docs information architecture moves.

/documentation/song/*                 https://docs.overture.bio/develop/Song/overview       301!
/documentation/score/*                https://docs.overture.bio/develop/Score/overview      301!
/documentation/maestro/*              https://docs.overture.bio/develop/Maestro/overview    301!
/documentation/arranger/*             https://docs.overture.bio/develop/Arranger/overview   301!
/documentation/stage/*                https://docs.overture.bio/develop/Stage/overview      301!
/documentation/guides/deployment/*    https://docs.overture.bio/deploy/deployment           301!
/documentation/guides/administration/* https://docs.overture.bio/use                        301!
/documentation/guides/submission/*    https://docs.overture.bio/use/cli-submissions         301!
/documentation/guides/download/*      https://docs.overture.bio/use/cli-downloads           301!
/documentation/dms/*                  https://docs.overture.bio/deploy/prelude              301!
/documentation/ego/*                  https://docs.overture.bio/deploy/deployment/keycloak  301!

# Catch-all: must stay last of the /documentation rules.
/documentation/*                      https://docs.overture.bio/develop                     301!

# ---------------------------------------------------------------------------
# 2. Routes the rebuild retired
# ---------------------------------------------------------------------------
#
# No force on these: the pages genuinely do not exist in this build, and Netlify
# applies a redirect when nothing else matches. Forcing would only mask a future
# page at the same path.
#
# `src/marketing/constants/pages.ts` carries the same list beside the path
# constants. Keep the two in step.

# Retired in rebuild phase 1. The Get Started handoff points at the docs
# quickstart, which is the whole reason this page could go.
/getting-started/*      https://docs.overture.bio/deploy/prelude        301

# Retired in rebuild phase 1, folded into the funding page. That page has since
# been retired too, so this goes straight to the docs site rather than chaining
# through /about/funding/, which no longer exists.
/acknowledgements/*     https://docs.overture.bio/community/funding     301

# The two pages phase 1 moved out of the docs and onto the marketing site, moved
# back. Each held a second copy of a document whose maintained version is on the
# docs site: five grants, and one paper with its citation formats.
/about/funding/*        https://docs.overture.bio/community/funding     301
/impact/publications/*  https://docs.overture.bio/community/citing-us   301

# Renamed in rebuild phase 4. "Services" read commercial for a not-for-profit.
/services/*             /collaborate/                                   301

# Renamed in rebuild phase 4. This is the one that matters: it is the only
# retired route with inbound fragment links (`#icgcargo` and its siblings).
# Browsers preserve the fragment across a 301 and do not send it to the server,
# so what makes those links land is the matching ids kept on the /impact/ hub,
# not anything in this file. Do not renumber or tidy those ids.
/case-studies/*         /impact/                                        301

# The four platform pages, retired when the hub absorbed their write-ups: the
# content did not move sites, it moved up one level into a section of /impact/.
# The fragment is written out here, unlike the /case-studies/ rule above,
# because an inbound link to one of these carries no fragment of its own.
#
# The ids are `Platform.id` in data/platforms.ts, which is why two do not match
# their old slug: /imicroseq/ is `#virusseq` and /hcmi/ is `#humanCancerModels`,
# both older spellings kept so existing links still land.
/impact/icgc-argo/*     /impact/#icgcargo                               301
/impact/imicroseq/*     /impact/#virusseq                               301
/impact/ihcc/*          /impact/#ihcc                                   301
/impact/hcmi/*          /impact/#humanCancerModels                      301

# Removed rather than renamed. /about-us/ was a page; what it said is now the
# "What we do" band on the home page, so this lands on that band rather than on
# the top of the page. The fragment is the `id` on the band's own heading
# (HomeCollaborate.tsx), spelled once as `ABOUT_BAND` in constants/pages.ts.
/about-us/*             /#collaborate-heading                           301

# The address the marketing home had while both sites came out of one build, on
# docs.overture.bio rather than here. Carried on this host too so a link copied
# out of the shared build during the port still lands.
/home/*                 /                                               301
